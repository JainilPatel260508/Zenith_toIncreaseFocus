{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "version": "1.0.0",
  "identifier": "com.jainilpatel.zenith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:15420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenith",
        "width": 1240,
        "height": 850,
        "minWidth": 800,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#111315"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Make room for meaningful work.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 640, "height": 420 },
        "appPosition": { "x": 170, "y": 190 },
        "applicationFolderPosition": { "x": 470, "y": 190 }
      }
    }
  }
}
